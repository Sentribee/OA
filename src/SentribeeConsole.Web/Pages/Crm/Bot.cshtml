@page "/oa/bot"
@model SentribeeConsole.Web.Pages.Crm.BotModel
@{
    Layout = "_CrmLayout";
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<form method="post" enctype="multipart/form-data" class="card">
    <div class="card-body">
        <input asp-for="Input.Id" type="hidden" />
        <input asp-for="Input.AvatarUrl" type="hidden" />
        <div class="row g-5">
            <div class="col-12 col-lg-4">
                <h3 class="card-title fs-6">Support identity</h3>
                <p class="card-subtitle text-body-secondary">Set the assistant name, avatar, and public chat path.</p>
                <div class="crm-bot-avatar mt-4">
                    @if (!string.IsNullOrWhiteSpace(Model.Input.AvatarUrl))
                    {
                        <img src="/api/crm/bots/@Model.Input.Id/avatar" alt="" />
                    }
                    else
                    {
                        <i class="material-symbols-rounded">smart_toy</i>
                    }
                </div>
                <input class="form-control mt-3" type="file" name="avatar" accept="image/*" />
                <div class="crm-chat-qr-card mt-4">
                    <div class="crm-chat-qr">
                        <img src="@Url.Page("/Crm/Bot", "ChatQr")" alt="Chat QR code" />
                    </div>
                    <div class="fw-semibold mt-3">Chat QR code</div>
                    <div class="text-body-secondary fs-8">@Model.PublicChatUrl</div>
                    <a class="btn btn-sm btn-outline-primary w-100 mt-3" href="@Url.Page("/Crm/Bot", "ChatQr", new { download = true })">Download PNG</a>
                </div>
            </div>
            <div class="col-12 col-lg-8">
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <label class="form-label" asp-for="Input.BotName">Bot name</label>
                        <input asp-for="Input.BotName" class="form-control" />
                        <span asp-validation-for="Input.BotName" class="text-danger fs-8"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" asp-for="Input.PublicChatPath">Public path</label>
                        <input asp-for="Input.PublicChatPath" class="form-control" />
                        <div class="form-text">chat.sentribee.ai/@Model.Input.PublicChatPath</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" asp-for="Input.ModelName">OpenAI model</label>
                        <input asp-for="Input.ModelName" class="form-control" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" asp-for="Input.Status">Status</label>
                        <select asp-for="Input.Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Draft">Draft</option>
                            <option value="Paused">Paused</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Input.WelcomeMessage">Welcome message</label>
                        <input asp-for="Input.WelcomeMessage" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Input.SystemPrompt">System prompt</label>
                        <textarea asp-for="Input.SystemPrompt" class="form-control" rows="7"></textarea>
                    </div>
                </div>
                <div class="d-flex justify-content-end mt-5">
                    <button type="submit" class="btn btn-primary">Save Bot</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
