@page "/oa/FarmerSurvey"
@model SentribeeConsole.Web.Pages.Crm.FarmerSurveyModel
@{
    Layout = null;
    ViewData["Title"] = "New Zealand Livestock Farm Operations Survey";

    string[] roleOptions = ["Farm Owner", "Farm Manager", "Sharemilker", "Farm Worker", "Other"];
    string[] regionOptions = ["Northland", "Auckland", "Waikato", "Bay of Plenty", "Gisborne", "Hawke's Bay", "Taranaki", "Manawatū-Whanganui", "Wellington", "Tasman / Nelson", "Marlborough", "Canterbury", "West Coast", "Otago", "Southland", "Other"];
    string[] operationOptions = ["Dairy cattle", "Beef cattle", "Sheep", "Dairy + Beef", "Beef + Sheep", "Dairy + Sheep", "Mixed cattle and sheep", "Other"];
