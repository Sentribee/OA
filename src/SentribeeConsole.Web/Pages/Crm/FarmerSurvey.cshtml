    string[] inspectionOptions = ["Multiple times per day", "Daily", "Several times per week", "Weekly", "Less frequently", "Mainly when a problem is noticed"];
    string[] monitoringDifficultyOptions = ["Large farm area", "Large number of animals", "Animals spread across multiple paddocks / blocks", "Limited staff availability", "Difficult terrain", "Weather conditions", "Difficult to identify or locate individual animals", "Existing technology does not provide enough information", "Individual animal monitoring is not a major challenge", "Other"];
    string[] detectionOptions = ["Visual observation by staff", "Change in behaviour", "Change in milk production", "Wearable device / sensor alert", "Camera / monitoring system", "During milking", "During routine handling", "Veterinary examination", "Other"];
    string[] technologyOptions = ["Electronic ID / RFID", "Smart collars / wearable devices", "GPS livestock tracking", "Virtual fencing", "Cameras / computer vision", "Automatic milking systems", "Automated weighing systems", "Drones", "Farm management software", "Animal health monitoring systems", "None", "Other"];
    string[] satisfactionOptions = ["Very satisfied", "Satisfied", "Neutral", "Dissatisfied", "Very dissatisfied", "Not applicable"];
    string[] limitationOptions = ["Too expensive", "Difficult to use", "Requires too much maintenance", "Limited coverage / connectivity", "Too many false alerts", "Does not provide enough useful information", "Different systems do not work well together", "Does not reduce enough manual work", "Other", "Not applicable"];
    string[] improvementOptions = ["Reduce labour requirements", "Animal health monitoring", "Earlier detection of animal problems", "Finding / locating animals", "Livestock movement", "Reproduction management", "Grazing / pasture management", "Animal growth / productivity", "Farm planning", "Record keeping and administration", "Compliance and reporting", "Better use of existing farm data", "Recommendations for farm management", "Other"];
    string[] followUpOptions = ["Yes", "Maybe — I would like to know more", "No"];

    var optionZh = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        ["Farm Owner"] = "农场主", ["Farm Manager"] = "农场经理", ["Sharemilker"] = "分成制奶农", ["Farm Worker"] = "农场工作人员", ["Other"] = "其他",
        ["Northland"] = "北地大区", ["Auckland"] = "奥克兰大区", ["Waikato"] = "怀卡托大区", ["Bay of Plenty"] = "丰盛湾大区", ["Gisborne"] = "吉斯伯恩大区", ["Hawke's Bay"] = "霍克斯湾大区", ["Taranaki"] = "塔拉纳基大区", ["Manawatū-Whanganui"] = "马纳瓦图－旺格努伊大区", ["Wellington"] = "惠灵顿大区", ["Tasman / Nelson"] = "塔斯曼／尼尔森", ["Marlborough"] = "马尔堡大区", ["Canterbury"] = "坎特伯雷大区", ["West Coast"] = "西海岸大区", ["Otago"] = "奥塔哥大区", ["Southland"] = "南地大区",
        ["Dairy cattle"] = "奶牛", ["Beef cattle"] = "肉牛", ["Sheep"] = "绵羊", ["Dairy + Beef"] = "奶牛＋肉牛", ["Beef + Sheep"] = "肉牛＋绵羊", ["Dairy + Sheep"] = "奶牛＋绵羊", ["Mixed cattle and sheep"] = "牛羊混合养殖",
        ["None"] = "无", ["Less than 200"] = "少于 200 头", ["200–500"] = "200–500 头", ["501–800"] = "501–800 头", ["801–1,000"] = "801–1,000 头", ["1,001–2,000"] = "1,001–2,000 头", ["More than 2,000"] = "超过 2,000 头",
        ["Less than 500"] = "少于 500 只", ["500–1,000"] = "500–1,000 只", ["2,001–5,000"] = "2,001–5,000 只", ["More than 5,000"] = "超过 5,000 只",
        ["Less than 100 ha"] = "少于 100 公顷", ["100–300 ha"] = "100–300 公顷", ["301–500 ha"] = "301–500 公顷", ["501–1,000 ha"] = "501–1,000 公顷", ["More than 1,000 ha"] = "超过 1,000 公顷",
        ["1–2"] = "1–2 人", ["3–5"] = "3–5 人", ["6–10"] = "6–10 人", ["11–20"] = "11–20 人", ["More than 20"] = "超过 20 人",
        ["Labour availability / staff shortage"] = "劳动力不足／员工短缺", ["Labour costs"] = "人工成本", ["Animal health"] = "动物健康", ["Animal mortality"] = "动物死亡率", ["Reproduction performance"] = "繁殖表现", ["Grazing / pasture management"] = "放牧／牧场管理", ["Finding or monitoring individual animals"] = "寻找或监测个体动物", ["Moving livestock"] = "转移动物", ["Fencing and infrastructure"] = "围栏与基础设施", ["Feed costs / feed management"] = "饲料成本／饲料管理", ["Weather and climate conditions"] = "天气与气候条件", ["Biosecurity"] = "生物安全", ["Compliance and reporting"] = "合规与报告", ["Farm data management"] = "农场数据管理", ["Overall operating costs"] = "整体运营成本",
        ["Checking / inspecting livestock"] = "检查／巡视牲畜", ["Finding individual animals"] = "寻找个体动物", ["Feeding"] = "饲喂", ["Animal health treatment"] = "动物健康治疗", ["Reproduction management"] = "繁殖管理", ["Pasture management"] = "牧场管理", ["Fencing / infrastructure maintenance"] = "围栏／基础设施维护", ["Record keeping / administration"] = "记录／行政工作", ["Compliance / reporting"] = "合规／报告", ["Equipment maintenance"] = "设备维护",
        ["Animal disease / health issues"] = "动物疾病／健康问题", ["Feed costs"] = "饲料成本", ["Milk production"] = "产奶量", ["Weight gain / growth performance"] = "增重／生长表现", ["Weather / environmental conditions"] = "天气／环境条件", ["Compliance costs"] = "合规成本",
        ["Visual inspection by staff"] = "员工目视检查", ["Electronic ID / RFID tags"] = "电子识别／RFID 标签", ["Smart collars / wearable devices"] = "智能项圈／可穿戴设备", ["Cameras"] = "摄像头", ["Milking system data"] = "挤奶系统数据", ["Weighing systems"] = "称重系统", ["Veterinary checks"] = "兽医检查", ["Farm management software"] = "农场管理软件",
        ["Multiple times per day"] = "每天多次", ["Daily"] = "每天", ["Several times per week"] = "每周数次", ["Weekly"] = "每周", ["Less frequently"] = "频率更低", ["Mainly when a problem is noticed"] = "主要在发现问题时",
        ["Large farm area"] = "农场面积大", ["Large number of animals"] = "动物数量多", ["Animals spread across multiple paddocks / blocks"] = "动物分散在多个牧区／地块", ["Limited staff availability"] = "可用员工有限", ["Difficult terrain"] = "地形复杂", ["Weather conditions"] = "天气条件", ["Difficult to identify or locate individual animals"] = "难以识别或定位个体动物", ["Existing technology does not provide enough information"] = "现有技术提供的信息不足", ["Individual animal monitoring is not a major challenge"] = "个体动物监测并非主要难题",
        ["Visual observation by staff"] = "员工目视观察", ["Change in behaviour"] = "行为变化", ["Change in milk production"] = "产奶量变化", ["Wearable device / sensor alert"] = "可穿戴设备／传感器警报", ["Camera / monitoring system"] = "摄像头／监测系统", ["During milking"] = "挤奶过程中", ["During routine handling"] = "日常操作过程中", ["Veterinary examination"] = "兽医检查",
        ["Electronic ID / RFID"] = "电子识别／RFID", ["GPS livestock tracking"] = "GPS 牲畜追踪", ["Virtual fencing"] = "虚拟围栏", ["Cameras / computer vision"] = "摄像头／计算机视觉", ["Automatic milking systems"] = "自动挤奶系统", ["Automated weighing systems"] = "自动称重系统", ["Drones"] = "无人机", ["Animal health monitoring systems"] = "动物健康监测系统",
        ["Very satisfied"] = "非常满意", ["Satisfied"] = "满意", ["Neutral"] = "一般", ["Dissatisfied"] = "不满意", ["Very dissatisfied"] = "非常不满意", ["Not applicable"] = "不适用",
        ["Too expensive"] = "价格过高", ["Difficult to use"] = "使用困难", ["Requires too much maintenance"] = "维护需求过多", ["Limited coverage / connectivity"] = "覆盖范围／连接受限", ["Too many false alerts"] = "误报过多", ["Does not provide enough useful information"] = "无法提供足够的有用信息", ["Different systems do not work well together"] = "不同系统之间兼容性差", ["Does not reduce enough manual work"] = "无法充分减少人工工作",
        ["Reduce labour requirements"] = "减少人工需求", ["Animal health monitoring"] = "动物健康监测", ["Earlier detection of animal problems"] = "更早发现动物问题", ["Finding / locating animals"] = "寻找／定位动物", ["Livestock movement"] = "牲畜转移", ["Animal growth / productivity"] = "动物生长／生产力", ["Farm planning"] = "农场规划", ["Record keeping and administration"] = "记录与行政管理", ["Better use of existing farm data"] = "更好地利用现有农场数据", ["Recommendations for farm management"] = "提供农场管理建议",
