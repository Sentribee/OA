@page "/oa/mindmaps/share/{shareToken}"
@model SentribeeConsole.Web.Pages.Crm.MindMapShareModel
@using System.Text.Json
@{
    Layout = null;
    var activitiesJson = JsonSerializer.Serialize(Model.Activities.Select(MindMapEditorModel.ToActivityJson));
}

<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Map?.Title - Sentribee OA</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link rel="stylesheet" href="~/theme/vendor-DDXwb3B2.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/mind-elixir@5.13.0/dist/MindElixir.css" />
</head>
<body class="mindmap-share-body">
    @if (Model.Map is not null)
    {
        <form id="mindmap-share-form" method="post" asp-page-handler="Save">
            @Html.AntiForgeryToken()
        </form>
        <header class="mindmap-share-header">
            <div>
                <div class="text-body-secondary fs-8">@Model.Map.BusinessName · @Model.Map.ParticipantName</div>
                <h1>@Model.Map.Title</h1>
            </div>
            <div class="mindmap-share-actions">
                <span class="mindmap-tag" style="--tag-color:@Model.Map.ColorTag">@Model.Map.MapStatus</span>
                <input id="mindmap-share-state" class="form-control form-control-sm" readonly value="Loaded" />
                <button type="button" id="mindmap-share-save" class="btn btn-primary btn-sm">
                    <i class="material-symbols-rounded">save</i> Save
                </button>
            </div>
        </header>
        <div id="mindmap-share-overlay" class="mindmap-activity-overlay"></div>
        <main class="mindmap-share-main">
            <section id="mindmap-share-canvas" class="mindmap-share-canvas"></section>
            <aside class="mindmap-share-side">
                <h2>Recent changes</h2>
                <div id="mindmap-share-activity-list" class="mindmap-side-list"></div>
            </aside>
        </main>

        <script type="module">
            import MindElixir from 'https://cdn.jsdelivr.net/npm/mind-elixir@5.13.0/dist/MindElixir.js';

            const rawMapJson = @Html.Raw(JsonSerializer.Serialize(Model.Map.MapJson));
            const initialTitle = @Html.Raw(JsonSerializer.Serialize(Model.Map.Title));
            const myEmail = @Html.Raw(JsonSerializer.Serialize(Model.Map.ParticipantEmail));
            const myName = @Html.Raw(JsonSerializer.Serialize(Model.Map.ParticipantName));
            const canvas = document.getElementById('mindmap-share-canvas');
            const state = document.getElementById('mindmap-share-state');
            const saveButton = document.getElementById('mindmap-share-save');
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const activityList = document.getElementById('mindmap-share-activity-list');
            const overlay = document.getElementById('mindmap-share-overlay');
            const normalizeActivity = (item) => ({
                id: item.id ?? item.Id ?? 0,
                participantId: item.participantId ?? item.ParticipantId,
                actorName: item.actorName ?? item.ActorName,
                actorEmail: item.actorEmail ?? item.ActorEmail,
                colorTag: item.colorTag ?? item.ColorTag,
                nodeId: item.nodeId ?? item.NodeId,
                nodeTopic: item.nodeTopic ?? item.NodeTopic,
                summary: item.summary ?? item.Summary,
                createdAtUtc: item.createdAtUtc ?? item.CreatedAtUtc
            });
            let activities = (@Html.Raw(activitiesJson)).map(normalizeActivity);
            let lastActivityId = activities[0]?.id || 0;
            let saveTimer;
            let saving = false;
            let dirty = false;
            let lastUpdatedAt = @Html.Raw(JsonSerializer.Serialize(Model.Map.UpdatedAtUtc.ToString("O")));
            let lastOperation = null;

            const buildDefaultData = () => {
                const data = MindElixir.new(initialTitle || 'Product brainstorm');
                data.nodeData.topic = initialTitle || 'Product brainstorm';
                data.nodeData.root = true;
                return data;
            };

            const normalizeMapData = (data) => {
                if (!data?.nodeData) {
                    return buildDefaultData();
                }

                data.nodeData.id = data.nodeData.id || `root-${Date.now()}`;
                data.nodeData.topic = data.nodeData.topic || initialTitle || 'Product brainstorm';
                data.nodeData.root = true;
                if (!Array.isArray(data.nodeData.children)) {
                    data.nodeData.children = [];
                }

                return data;
            };

            const parseData = (json) => {
                try {
                    const data = JSON.parse(json);
                    if (data?.nodeData) {
                        return normalizeMapData(data);
                    }
                } catch {
                    // Use default data if the stored document cannot be parsed.
                }

                return buildDefaultData();
            };

            const mind = new MindElixir({
                el: canvas,
                direction: MindElixir.SIDE,
                draggable: true,
                contextMenu: true,
                toolBar: true,
                nodeMenu: true,
                keypress: true,
                locale: 'en',
                overflowHidden: false
            });
            mind.init(parseData(rawMapJson));
            requestAnimationFrame(() => {
                window.dispatchEvent(new Event('resize'));
                if (typeof mind.toCenter === 'function') {
                    mind.toCenter();
                }
            });

            const getMapJson = () => typeof mind.getDataString === 'function'
                ? mind.getDataString()
                : JSON.stringify(mind.getData());

            const setState = (value) => {
                state.value = value;
            };

            const operationSummary = (operation) => {
                if (!operation) {
                    return `${myName || 'Participant'} updated the mind map`;
                }

                const name = operation.name || operation.type || 'operation';
                const topic = operation.obj?.topic || operation.node?.topic || operation.topic;
                return topic ? `${name}: ${topic}` : `Mind map ${name}`;
            };

            const operationNode = (operation) => ({
                nodeId: operation?.obj?.id || operation?.node?.id || operation?.id || '',
                nodeTopic: operation?.obj?.topic || operation?.node?.topic || operation?.topic || ''
            });

            const renderActivities = () => {
                activityList.innerHTML = '';
                activities.slice(0, 12).forEach((activity) => {
                    const item = document.createElement('div');
                    item.className = 'mindmap-activity-item';
                    item.innerHTML = `
                        <span class="mindmap-color-dot" style="--tag-color:${activity.colorTag || '#7c3aed'}"></span>
                        <div>
                            <div><strong>${activity.actorName || 'Participant'}</strong> <span>${activity.summary || 'Updated the map'}</span></div>
                            <div class="text-body-secondary fs-8">${new Date(activity.createdAtUtc).toLocaleString()}</div>
                        </div>`;
                    activityList.appendChild(item);
                });
            };

            const showRemoteNotice = () => {
                const newestRemote = activities.find(item => item.id > lastActivityId && item.actorEmail !== myEmail);
                if (!newestRemote) {
                    return;
                }

                overlay.innerHTML = `<span style="--tag-color:${newestRemote.colorTag || '#7c3aed'}"></span><strong>${newestRemote.actorName}</strong> ${newestRemote.summary}`;
                overlay.classList.add('show');
                window.setTimeout(() => overlay.classList.remove('show'), 6500);
                lastActivityId = Math.max(lastActivityId, newestRemote.id);
            };

            const saveMap = async () => {
                if (saving) {
                    return;
                }

                saving = true;
                setState('Saving...');
                const node = operationNode(lastOperation);
                const body = new URLSearchParams();
                body.set('mapJson', getMapJson());
                body.set('operationSummary', operationSummary(lastOperation));
                body.set('nodeId', node.nodeId);
                body.set('nodeTopic', node.nodeTopic);
                body.set('__RequestVerificationToken', token);

                try {
                    const response = await fetch(`${location.pathname}?handler=Save`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                            'RequestVerificationToken': token
                        },
                        body
                    });
                    const result = await response.json();
                    if (result.success) {
                        dirty = false;
                        lastUpdatedAt = result.updatedAtUtc || result.UpdatedAtUtc;
                        setState(`Saved ${result.savedAt}`);
                        await pollRemote(false);
                    } else {
                        setState(result.message || 'Save failed');
                    }
                } catch {
                    setState('Save failed');
                } finally {
                    saving = false;
                }
            };

            const scheduleSave = (operation = null) => {
                lastOperation = operation || lastOperation;
                dirty = true;
                window.clearTimeout(saveTimer);
                setState('Unsaved changes');
                saveTimer = window.setTimeout(saveMap, 1500);
            };

            const pollRemote = async (refreshMap = true) => {
                if (saving) {
                    return;
                }

                try {
                    const response = await fetch(`${location.pathname}?handler=Data`, { cache: 'no-store' });
                    const result = await response.json();
                    if (!result.success) {
                        return;
                    }

                    const nextUpdatedAt = result.updatedAtUtc || result.UpdatedAtUtc;
                    const nextMapJson = result.mapJson || result.MapJson;
                    activities = (result.activities || result.Activities || []).map(normalizeActivity);
                    renderActivities();
                    showRemoteNotice();
                    if (refreshMap && !dirty && nextUpdatedAt && nextUpdatedAt !== lastUpdatedAt) {
                        lastUpdatedAt = nextUpdatedAt;
                        if (typeof mind.refresh === 'function') {
                            mind.refresh(parseData(nextMapJson));
                        }
                        setState('Updated from meeting');
                    }
                } catch {
                    // Keep the current editing session usable.
                }
            };

            saveButton.addEventListener('click', saveMap);
            mind.bus.addListener('operation', scheduleSave);
            renderActivities();
            window.setTimeout(() => pollRemote(false), 800);
            window.setInterval(pollRemote, 5000);
        </script>
    }
</body>
</html>
