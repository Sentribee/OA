@page "/oa/staff/change-password"
@model SentribeeConsole.Web.Pages.Crm.StaffChangePasswordModel
@{
    Layout = "_CrmStaffLayout";
}

@if (!string.IsNullOrWhiteSpace(Model.AlertMessage))
{
    <div class="alert alert-warning">@Model.AlertMessage</div>
}

<div class="card mw-500">
    <div class="card-body">
        <h3 class="card-title fs-6">Set your password</h3>
        <p class="card-subtitle text-body-secondary">Your first login must replace the temporary password created by your administrator.</p>
        <form method="post" class="mt-4">
            <div asp-validation-summary="All" class="text-danger fs-8 mb-4"></div>
            <div class="mb-4">
                <label class="form-label" asp-for="NewPassword">New password</label>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger fs-8"></span>
            </div>
            <div class="mb-4">
                <label class="form-label" asp-for="ConfirmPassword">Confirm password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger fs-8"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save Password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
