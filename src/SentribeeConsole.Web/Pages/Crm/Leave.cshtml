@page "/oa/leave"
@model SentribeeConsole.Web.Pages.Crm.LeaveModel
@{
    Layout = "_CrmLayout";
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<div class="card mb-5">
    <div class="card-body">
        <div class="d-flex align-items-start mb-4">
            <div class="flex-grow-1">
                <h3 class="card-title fs-6">@(Model.Input.Id > 0 ? "Edit leave" : "Add leave")</h3>
                <p class="card-subtitle text-body-secondary">Approved paid leave is included in monthly pay hours. Unpaid leave is shown separately for payroll review.</p>
            </div>
            @if (Model.Input.Id > 0)
            {
                <a asp-page="/Crm/Leave" class="btn btn-outline-secondary btn-sm">New Leave</a>
            }
        </div>
        <form method="post" asp-page-handler="Save">
            <input type="hidden" asp-for="Input.Id" />
            <div class="row g-4">
                <div class="col-12 col-md-4">
                    <label class="form-label" asp-for="Input.EmployeeId">Employee</label>
                    <select asp-for="Input.EmployeeId" class="form-select">
                        <option value="">Select employee</option>
                        @foreach (var employee in Model.Employees)
                        {
                            <option value="@employee.Id">@employee.RealName@(string.IsNullOrWhiteSpace(employee.JobTitle) ? string.Empty : $" - {employee.JobTitle}")</option>
                        }
                    </select>
                    <span asp-validation-for="Input.EmployeeId" class="text-danger fs-8"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" asp-for="Input.LeaveType">Leave type</label>
                    <select asp-for="Input.LeaveType" class="form-select">
                        <option value="Annual">Annual leave</option>
                        <option value="Sick">Sick leave</option>
                        <option value="Unpaid">Unpaid leave</option>
                        <option value="Bereavement">Bereavement leave</option>
                        <option value="PublicHoliday">Public holiday</option>
                        <option value="Personal">Personal leave</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" asp-for="Input.Status">Status</label>
                    <select asp-for="Input.Status" class="form-select">
                        <option value="Approved">Approved</option>
                        <option value="Pending">Pending</option>
                        <option value="Rejected">Rejected</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label" asp-for="Input.StartDate">Start date</label>
                    <input asp-for="Input.StartDate" type="date" class="form-control" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label" asp-for="Input.EndDate">End date</label>
                    <input asp-for="Input.EndDate" type="date" class="form-control" />
                    <span asp-validation-for="Input.EndDate" class="text-danger fs-8"></span>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label" asp-for="Input.Hours">Hours</label>
                    <input asp-for="Input.Hours" type="number" step="0.25" min="0.25" class="form-control" />
                    <span asp-validation-for="Input.Hours" class="text-danger fs-8"></span>
                </div>
                <div class="col-12 col-md-3 d-flex align-items-end">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="Input.IsPaid" class="form-check-input" />
                        <label class="form-check-label" asp-for="Input.IsPaid">Paid leave</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="Input.Reason">Reason</label>
                    <input asp-for="Input.Reason" class="form-control" />
                    <span asp-validation-for="Input.Reason" class="text-danger fs-8"></span>
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="Input.Notes">Notes</label>
                    <textarea asp-for="Input.Notes" rows="3" class="form-control"></textarea>
                </div>
            </div>
            <div class="d-flex justify-content-end mt-5">
                <button type="submit" class="btn btn-primary">Save Leave</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex align-items-start mb-4">
            <div class="flex-grow-1">
                <h3 class="card-title fs-6">Leave records</h3>
                <p class="card-subtitle text-body-secondary">Latest 120 leave items.</p>
            </div>
            <a asp-page="/Crm/Payroll" class="btn btn-outline-primary btn-sm">Monthly Payroll</a>
        </div>
        <div class="table-responsive mobile-card-table-wrap">
            <table class="table align-middle mobile-card-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Hours</th>
                        <th>Paid</th>
                        <th>Status</th>
                        <th>Reason</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Leaves.Count == 0)
                    {
                        <tr><td colspan="8" class="text-body-secondary">No leave records yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Leaves)
                        {
                            <tr>
                                <td data-label="Employee">
                                    <div class="fw-semibold">@item.RealName</div>
                                    <div class="text-body-secondary fs-8">@item.PreferredName</div>
                                </td>
                                <td data-label="Type">@item.LeaveType</td>
                                <td data-label="Date">
                                    <div>@item.StartDate.ToString("yyyy-MM-dd")</div>
                                    <div class="text-body-secondary fs-8">@item.EndDate.ToString("yyyy-MM-dd")</div>
                                </td>
                                <td data-label="Hours">@item.Hours.ToString("0.##")</td>
                                <td data-label="Paid">@(item.IsPaid ? "Paid" : "Unpaid")</td>
                                <td data-label="Status"><span class="badge bg-light text-body">@item.Status</span></td>
                                <td data-label="Reason">
                                    <div>@item.Reason</div>
                                    <div class="text-body-secondary fs-8">@item.Notes</div>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-page="/Crm/Leave" asp-route-leaveId="@item.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                                        @if (item.Status != "Approved")
                                        {
                                            <form method="post" asp-page-handler="SetStatus">
                                                <input type="hidden" name="leaveId" value="@item.Id" />
                                                <input type="hidden" name="status" value="Approved" />
                                                <button type="submit" class="btn btn-outline-secondary btn-sm">Approve</button>
                                            </form>
                                        }
                                        @if (item.Status != "Cancelled")
                                        {
                                            <form method="post" asp-page-handler="SetStatus">
                                                <input type="hidden" name="leaveId" value="@item.Id" />
                                                <input type="hidden" name="status" value="Cancelled" />
                                                <button type="submit" class="btn btn-outline-secondary btn-sm">Cancel</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
