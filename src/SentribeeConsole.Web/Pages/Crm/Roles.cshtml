@page "/oa/roles"
@model SentribeeConsole.Web.Pages.Crm.RolesModel
@{
    Layout = "_CrmLayout";
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<div class="card mb-5">
    <div class="card-body">
        <div class="d-flex align-items-start mb-4">
            <div class="flex-grow-1">
                <h3 class="card-title fs-6">@(Model.Input.Id > 0 ? "Edit role" : "Add role")</h3>
                <p class="card-subtitle text-body-secondary">Roles control staff login permissions and workflow approvals.</p>
            </div>
            @if (Model.Input.Id > 0)
            {
                <a asp-page="/Crm/Roles" class="btn btn-outline-secondary btn-sm">New Role</a>
            }
        </div>
        <form method="post" asp-page-handler="Save">
            <input type="hidden" asp-for="Input.Id" />
            <div class="row g-4">
                <div class="col-12 col-md-4">
                    <label class="form-label" asp-for="Input.RoleName">Role name</label>
                    <input asp-for="Input.RoleName" class="form-control" placeholder="Manager, Team Lead, Staff" />
                    <span asp-validation-for="Input.RoleName" class="text-danger fs-8"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" asp-for="Input.Status">Status</label>
                    <select asp-for="Input.Status" class="form-select">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="Input.Description">Description</label>
                    <input asp-for="Input.Description" class="form-control" />
                </div>
                <div class="col-12 col-md-4">
                    <div class="form-check form-switch">
                        <input asp-for="Input.CanApproveLeave" class="form-check-input" />
                        <label asp-for="Input.CanApproveLeave" class="form-check-label">Can approve leave</label>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="form-check form-switch">
                        <input asp-for="Input.CanManageAttendance" class="form-check-input" />
                        <label asp-for="Input.CanManageAttendance" class="form-check-label">Can manage attendance</label>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="form-check form-switch">
                        <input asp-for="Input.CanManageEmployees" class="form-check-input" />
                        <label asp-for="Input.CanManageEmployees" class="form-check-label">Can manage employees</label>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end mt-5">
                <button type="submit" class="btn btn-primary">Save Role</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h3 class="card-title fs-6">Role list</h3>
        <div class="table-responsive mobile-card-table-wrap mt-4">
            <table class="table align-middle mobile-card-table">
                <thead>
                    <tr>
                        <th>Role</th>
                        <th>Permissions</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Roles.Count == 0)
                    {
                        <tr><td colspan="4" class="text-body-secondary">No roles yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Roles)
                        {
                            <tr>
                                <td data-label="Role">
                                    <div class="fw-semibold">@item.RoleName</div>
                                    <div class="text-body-secondary fs-8">@item.Description</div>
                                </td>
                                <td data-label="Permissions">
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (item.CanApproveLeave)
                                        {
                                            <span class="badge bg-light text-body">Leave approval</span>
                                        }
                                        @if (item.CanManageAttendance)
                                        {
                                            <span class="badge bg-light text-body">Attendance</span>
                                        }
                                        @if (item.CanManageEmployees)
                                        {
                                            <span class="badge bg-light text-body">Employees</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="Status"><span class="badge bg-light text-body">@item.Status</span></td>
                                <td class="text-end">
                                    <a asp-page="/Crm/Roles" asp-route-roleId="@item.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
