@page "/oa/forgot-password"
@model SentribeeConsole.Web.Pages.Crm.ForgotPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
    ViewData["AuthBodyClass"] = "crm-login-shell";
}

<div id="login-feedback"
     class="login-toast @(string.IsNullOrEmpty(Model.AlertMessage) ? null : "is-visible")"
     role="alert"
     aria-live="assertive">
    <i class="material-symbols-rounded">info</i>
    <span>@Model.AlertMessage</span>
</div>

<section class="card login-card mw-400 w-100 p-7 p-md-8">
    <div class="d-flex align-items-center gap-3 mb-7">
        <img class="brand-logo" src="~/images/sentribee-mark.png" alt="SentriBee" width="44" height="44" />
        <div>
            <h1 class="login-brand-name fs-5 mb-0">Sentribee OA</h1>
            <div class="text-body-secondary fs-7">Staff password reset</div>
        </div>
    </div>
    <h2 class="fs-6 text-body-emphasis">Forgot password</h2>
    <div class="text-body-secondary mb-5">Enter your staff work email. If the account exists, we will send a reset link.</div>

    <form method="post" class="mb-5" novalidate>
        <div class="form-icon mb-4">
            <i class="material-symbols-rounded">mail</i>
            <input asp-for="Email" class="form-control" placeholder="Work email" autocomplete="email" inputmode="email" />
        </div>
        <span asp-validation-for="Email" class="text-danger fs-8 d-block mb-3"></span>
        <button type="submit" class="btn btn-primary w-100">
            <i class="material-symbols-rounded">outgoing_mail</i> Send reset link
        </button>
    </form>

    <a asp-page="/Crm/Login" class="btn btn-outline-secondary w-100">
        <i class="material-symbols-rounded">arrow_back</i> Back to sign in
    </a>
</section>
