@page "/oa/conversations"
@model SentribeeConsole.Web.Pages.Crm.ConversationsModel
@using SentribeeConsole.Web.Application.Services
@using SentribeeConsole.Web.Domain.Entities
@{
    Layout = "_CrmLayout";
}

<div class="row g-5">
    <div class="col-12 col-xl-5">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title fs-6">Conversation history</h3>
                <div class="crm-conversation-list mt-4">
                    @if (Model.Conversations.Items.Count == 0)
                    {
                        <div class="text-body-secondary">No conversations yet.</div>
                    }
                    else
                    {
                        @foreach (var item in Model.Conversations.Items)
                        {
                            <a class="crm-conversation-item @(item.Id == Model.SelectedConversationId ? "active" : null)"
                               asp-page="/Crm/Conversations"
                               asp-route-conversationId="@item.Id">
                                <div class="fw-semibold">@(item.VisitorLabel ?? $"Visitor {item.Id}")</div>
                                <div class="text-body-secondary fs-8">@item.Channel &middot; @item.BotName</div>
                                <div class="text-body-secondary fs-8">@item.MessageCount messages, @item.ImageMessageCount images</div>
                                <div class="text-body-secondary fs-8">@ProjectTimeZone.Format(item.LastMessageAtUtc ?? item.StartedAtUtc, Model.Merchant.TimeZoneId)</div>
                            </a>
                        }
                    }
                </div>
                @await Html.PartialAsync("_Pagination", new PagedResult<object>
                {
                    Items = Model.Conversations.Items.Cast<object>().ToList(),
                    PageNumber = Model.Conversations.PageNumber,
                    PageSize = Model.Conversations.PageSize,
                    TotalCount = Model.Conversations.TotalCount
                })
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-7">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title fs-6">Messages</h3>
                @if (Model.IsWeComConversation)
                {
                    <form method="post" asp-page-handler="Label" class="d-flex gap-2 my-3">
                        <input type="hidden" name="conversationId" value="@Model.SelectedConversationId" />
                        <label for="conversation-label" class="visually-hidden">Conversation alias</label>
                        <input id="conversation-label" class="form-control" name="label" value="@Model.ConversationLabel" maxlength="140" required />
                        <button class="btn btn-outline-primary" type="submit" title="Save conversation alias" aria-label="Save conversation alias"><i class="material-symbols-rounded">save</i></button>
                    </form>
                }
                @if (Model.SelectedConversationId is null)
                {
                    <p class="card-subtitle text-body-secondary">Select a conversation to inspect the context.</p>
                }
                else if (Model.Messages.Count == 0)
                {
                    <p class="card-subtitle text-body-secondary">No messages found for this conversation.</p>
                }
                else
                {
                    <div class="crm-message-list mt-4">
                        @foreach (var message in Model.Messages)
                        {
                            <div class="crm-message-row crm-message-@message.SenderRole.ToLowerInvariant()">
                                <div class="crm-message-meta d-flex align-items-center gap-2">
                                    @if (message.WeCom is { } wecom)
                                    {
                                        @if (!string.IsNullOrEmpty(wecom.AvatarUrl))
                                        {
                                            <img src="@wecom.AvatarUrl" alt="" width="32" height="32" referrerpolicy="no-referrer" loading="lazy" style="width:32px;height:32px;object-fit:cover;border-radius:50%;flex:none" />
                                        }
                                        <span>@(string.IsNullOrWhiteSpace(wecom.Name) ? wecom.UserId : wecom.Name) &middot; @wecom.MessageType</span>
                                        @if (!string.IsNullOrWhiteSpace(wecom.ChatName)) { <span>@wecom.ChatName</span> }
                                    }
                                    else { <span>@message.SenderRole</span> }
                                    <span>@ProjectTimeZone.Format(message.CreatedAtUtc, Model.Merchant.TimeZoneId)</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(message.ImageUrl))
                                {
                                    <img src="/api/crm/conversation-messages/@message.Id/image" alt="" />
                                }
                                @if (!string.IsNullOrWhiteSpace(message.Body))
                                {
                                    <div class="crm-message-body">@message.Body</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(message.ModelName))
                                {
                                    <div class="crm-message-meta">@message.ModelName, @(message.PromptTokens + message.CompletionTokens) tokens</div>
                                }
                                @if (message.WeCom is { } info)
                                {
                                    <details class="mt-2">
                                        <summary class="crm-message-meta">Message details</summary>
                                        <div class="crm-message-meta">User: @info.UserId @if (!string.IsNullOrEmpty(info.ChatId)) { <span>&middot; Group: @info.ChatId</span> }</div>
                                        <pre class="fs-8" style="white-space:pre-wrap;overflow-wrap:anywhere">@info.Details</pre>
                                    </details>
                                }
                            </div>
                        }
                    </div>
                    <nav class="d-flex justify-content-between mt-3" aria-label="Message pages">
                        @if (Model.HasMoreMessages) { <a asp-route-conversationId="@Model.SelectedConversationId" asp-route-messagePage="@(Model.MessagePage + 1)">Older messages</a> }
                        @if (Model.MessagePage > 1) { <a asp-route-conversationId="@Model.SelectedConversationId" asp-route-messagePage="@(Model.MessagePage - 1)">Newer messages</a> }
                    </nav>
                }
            </div>
        </div>
    </div>
</div>
