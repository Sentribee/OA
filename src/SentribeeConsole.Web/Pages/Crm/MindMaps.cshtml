@page "/oa/mindmaps"
@model SentribeeConsole.Web.Pages.Crm.MindMapsModel
@using System.Text.Json
@{
    Layout = "_CrmLayout";
    var candidatesJson = JsonSerializer.Serialize(Model.Candidates.Select(item => new
    {
        sourceType = item.SourceType,
        sourceId = item.SourceId,
        name = item.DisplayName,
        email = item.Email,
        label = $"{item.DisplayName} <{item.Email}>"
    }));
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert @(Model.StatusMessage.Contains("failed", StringComparison.OrdinalIgnoreCase) ? "alert-warning" : "alert-success")">@Model.StatusMessage</div>
}

<div class="crm-page-actions">
    <div>
        <div class="text-body-secondary fs-8">Workbench</div>
        <h2 class="crm-page-subtitle">Mind Maps</h2>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#mindmap-create-modal">
        <i class="material-symbols-rounded">add</i> New Map
    </button>
</div>

<div class="mindmap-table-shell">
    <div class="table-responsive">
        <table class="table align-middle mindmap-table mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>主题</th>
                    <th>导图状态</th>
                    <th>共享人数</th>
                    <th>创建时间</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Maps.Count == 0)
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state py-5">
                                <i class="material-symbols-rounded">psychology_alt</i>
                                <div class="fw-semibold">No mind maps yet</div>
                                <div class="text-body-secondary fs-8">Create one before a product brainstorming meeting.</div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var map in Model.Maps)
                    {
                        <tr>
                            <td class="text-body-secondary">#@map.Id</td>
                            <td>
                                <a class="fw-semibold text-decoration-none" asp-page="/Crm/MindMapEditor" asp-route-mapId="@map.Id">@map.Title</a>
                            </td>
                            <td><span class="badge mindmap-status-badge">@map.MapStatus</span></td>
                            <td>@map.SharedCount</td>
                            <td>@map.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-page="/Crm/MindMapEditor" asp-route-mapId="@map.Id">
                                        <i class="material-symbols-rounded">open_in_full</i> Edit
                                    </a>
                                    <form method="post" asp-page-handler="Invite">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="mapId" value="@map.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                            <i class="material-symbols-rounded">outgoing_mail</i> Invite All
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="mindmap-create-modal" tabindex="-1" aria-labelledby="mindmap-create-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create" id="mindmap-create-form">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h3 class="modal-title fs-5" id="mindmap-create-title">Create mind map</h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-4">
                        <div class="col-12 col-lg-8">
                            <label class="form-label" for="mindmap-new-title">主题</label>
                            <input id="mindmap-new-title" name="title" class="form-control" value="Product brainstorm" required maxlength="180" />
                        </div>
                        <div class="col-12 col-lg-4">
                            <label class="form-label" for="mindmap-new-status">导图状态</label>
                            <select id="mindmap-new-status" name="mapStatus" class="form-select">
                                <option value="Draft">Draft</option>
                                <option value="InProgress">In Progress</option>
                                <option value="Final">Final</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="mindmap-share-picker">共享人</label>
                            <div class="mindmap-share-picker">
                                <input id="mindmap-share-picker" class="form-control" list="mindmap-candidates" placeholder="Search employee or customer by name/email" autocomplete="off" />
                                <datalist id="mindmap-candidates">
                                    @foreach (var candidate in Model.Candidates)
                                    {
                                        <option value="@($"{candidate.DisplayName} <{candidate.Email}>")"></option>
                                    }
                                </datalist>
                                <button type="button" class="btn btn-outline-primary" id="mindmap-add-existing">
                                    <i class="material-symbols-rounded">person_add</i> Add
                                </button>
                            </div>
                            <div class="mindmap-manual-grid">
                                <input id="mindmap-manual-name" class="form-control" placeholder="Name" />
                                <input id="mindmap-manual-email" class="form-control" placeholder="Email" type="email" />
                                <button type="button" class="btn btn-outline-secondary" id="mindmap-add-manual">
                                    <i class="material-symbols-rounded">add</i> Manual
                                </button>
                            </div>
                            <div id="mindmap-participant-chips" class="mindmap-participant-chips"></div>
                            <div id="mindmap-hidden-participants"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="material-symbols-rounded">check</i> Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const candidates = @Html.Raw(candidatesJson);
            const picker = document.getElementById('mindmap-share-picker');
            const manualName = document.getElementById('mindmap-manual-name');
            const manualEmail = document.getElementById('mindmap-manual-email');
            const addExisting = document.getElementById('mindmap-add-existing');
            const addManual = document.getElementById('mindmap-add-manual');
            const chips = document.getElementById('mindmap-participant-chips');
            const hidden = document.getElementById('mindmap-hidden-participants');
            const participants = new Map();

            const findCandidate = (value) => {
                const query = (value || '').trim().toLowerCase();
                return candidates.find(item =>
                    item.label.toLowerCase() === query ||
                    item.email.toLowerCase() === query ||
                    item.name.toLowerCase() === query);
            };

            const render = () => {
                chips.innerHTML = '';
                hidden.innerHTML = '';
                for (const participant of participants.values()) {
                    const chip = document.createElement('span');
                    chip.className = 'mindmap-participant-chip';
                    chip.innerHTML = `<span>${participant.name || participant.email}</span><small>${participant.email}</small>`;
                    const remove = document.createElement('button');
                    remove.type = 'button';
                    remove.innerHTML = '&times;';
                    remove.addEventListener('click', () => {
                        participants.delete(participant.email.toLowerCase());
                        render();
                    });
                    chip.appendChild(remove);
                    chips.appendChild(chip);

                    for (const [name, value] of [
                        ['participantName', participant.name],
                        ['participantEmail', participant.email],
                        ['participantSourceType', participant.sourceType],
                        ['participantSourceId', participant.sourceId ?? '']
                    ]) {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = name;
                        input.value = value;
                        hidden.appendChild(input);
                    }
                }
            };

            const addParticipant = (participant) => {
                if (!participant?.email) {
                    return;
                }

                const email = participant.email.trim();
                if (!email.includes('@@')) {
                    return;
                }

                participants.set(email.toLowerCase(), {
                    name: participant.name?.trim() || email,
                    email,
                    sourceType: participant.sourceType || 'Manual',
                    sourceId: participant.sourceId || ''
                });
                render();
            };

            addExisting?.addEventListener('click', () => {
                const candidate = findCandidate(picker.value);
                if (candidate) {
                    addParticipant(candidate);
                    picker.value = '';
                }
            });

            picker?.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    addExisting.click();
                }
            });

            addManual?.addEventListener('click', () => {
                addParticipant({
                    name: manualName.value,
                    email: manualEmail.value,
                    sourceType: 'Manual',
                    sourceId: ''
                });
                manualName.value = '';
                manualEmail.value = '';
            });
        })();
    </script>
}
