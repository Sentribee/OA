@page "/oa/profiles"
@model SentribeeConsole.Web.Pages.Crm.ProfilesModel
@using SentribeeConsole.Web.Application.Services
@using SentribeeConsole.Web.Domain.Entities
@{
    Layout = "_CrmLayout";
}

<div class="dashboard-metric-grid mb-5">
    <div class="card dashboard-metric-card">
        <div class="dashboard-metric-value text-primary">@Model.Summary.TotalProfiles</div>
        <div class="dashboard-metric-label">Profiles</div>
    </div>
    <div class="card dashboard-metric-card">
        <div class="dashboard-metric-value text-success">@Model.Summary.AverageCompleteness.ToString("0")%</div>
        <div class="dashboard-metric-label">Average Detail</div>
    </div>
    <div class="card dashboard-metric-card">
        <div class="dashboard-metric-value text-warning">@Model.Summary.ContactCaptured</div>
        <div class="dashboard-metric-label">Contacts Captured</div>
    </div>
    <div class="card dashboard-metric-card">
        <div class="dashboard-metric-value text-danger">@Model.Summary.HighPriorityProfiles</div>
        <div class="dashboard-metric-label">High Priority</div>
    </div>
</div>

<div class="row g-5">
    <div class="col-12 col-xxl-7">
        <div class="card mb-5">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between gap-3 mb-4">
                    <div>
                        <h3 class="card-title fs-6">Customer profiles</h3>
                        <p class="card-subtitle text-body-secondary mb-0">Profiles are extracted from support chats and enriched after each conversation turn.</p>
                    </div>
                    <span class="badge bg-primary-subtle text-primary">@Model.Profiles.TotalCount total</span>
                </div>
                <div class="table-responsive mobile-card-table-wrap">
                    <table class="table align-middle mobile-card-table">
                        <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Intent</th>
                            <th>Quality</th>
                            <th>Updated</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.Profiles.Items.Count == 0)
                        {
                            <tr><td colspan="4" class="text-body-secondary">No customer profiles yet. New chats will create profiles automatically.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Profiles.Items)
                            {
                                <tr class="@(Model.SelectedProfileId == item.Id ? "table-active" : null)">
                                    <td data-label="Customer">
                                        <a class="fw-medium" asp-page="/Crm/Profiles" asp-route-profileId="@item.Id">@(!string.IsNullOrWhiteSpace(item.DisplayName) ? item.DisplayName : item.VisitorLabel ?? $"Profile {item.Id}")</a>
                                        <div class="text-body-secondary fs-8">@(!string.IsNullOrWhiteSpace(item.CompanyName) ? item.CompanyName : "Company unknown")</div>
                                        <div class="text-body-secondary fs-8">@(!string.IsNullOrWhiteSpace(item.Email) ? item.Email : item.Phone ?? "Contact unknown")</div>
                                    </td>
                                    <td data-label="Intent">
                                        <div>@(!string.IsNullOrWhiteSpace(item.IntentSummary) ? item.IntentSummary : "Intent not captured")</div>
                                        <div class="text-body-secondary fs-8">@(!string.IsNullOrWhiteSpace(item.ProductInterest) ? item.ProductInterest : "Interest unknown")</div>
                                    </td>
                                    <td data-label="Quality">
                                        <div class="crm-profile-quality">
                                            <div class="progress" role="progressbar" aria-label="Profile completeness" aria-valuenow="@item.ProfileCompleteness" aria-valuemin="0" aria-valuemax="100">
                                                <div class="progress-bar" style="width: @item.ProfileCompleteness%"></div>
                                            </div>
                                            <span>@item.ProfileCompleteness%</span>
                                        </div>
                                        <div class="text-body-secondary fs-8">Priority @item.PriorityScore &middot; @(item.Sentiment ?? "sentiment unknown")</div>
                                    </td>
                                    <td data-label="Updated">
                                        <div>@ProjectTimeZone.Format(item.UpdatedAtUtc, Model.Merchant.TimeZoneId)</div>
                                        @if (item.ConversationId.HasValue)
                                        {
                                            <a class="fs-8" asp-page="/Crm/Conversations" asp-route-conversationId="@item.ConversationId">Open conversation</a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
                @await Html.PartialAsync("_Pagination", new PagedResult<object>
                {
                    Items = Model.Profiles.Items.Cast<object>().ToList(),
                    PageNumber = Model.Profiles.PageNumber,
                    PageSize = Model.Profiles.PageSize,
                    TotalCount = Model.Profiles.TotalCount
                })
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-lg-4">
                <div class="card h-100"><div class="card-body">
                    <h3 class="card-title fs-6">Lifecycle</h3>
                    @foreach (var row in Model.LifecycleBreakdown)
                    {
                        <div class="crm-breakdown-row"><span>@row.Label</span><strong>@row.Count</strong></div>
                    }
                </div></div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="card h-100"><div class="card-body">
                    <h3 class="card-title fs-6">Sentiment</h3>
                    @foreach (var row in Model.SentimentBreakdown)
                    {
                        <div class="crm-breakdown-row"><span>@row.Label</span><strong>@row.Count</strong></div>
                    }
                </div></div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="card h-100"><div class="card-body">
                    <h3 class="card-title fs-6">Interests</h3>
                    @foreach (var row in Model.InterestBreakdown)
                    {
                        <div class="crm-breakdown-row"><span>@row.Label</span><strong>@row.Count</strong></div>
                    }
                </div></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xxl-5">
        <div class="card crm-profile-detail-card">
            <div class="card-body">
                @if (Model.SelectedProfile is null)
                {
                    <h3 class="card-title fs-6">Profile detail</h3>
                    <p class="card-subtitle text-body-secondary mb-0">Select a customer profile to view the detail captured from chats.</p>
                }
                else
                {
                    var profile = Model.SelectedProfile;
                    <div class="d-flex align-items-start justify-content-between gap-3 mb-4">
                        <div>
                            <h3 class="card-title fs-6">@(!string.IsNullOrWhiteSpace(profile.DisplayName) ? profile.DisplayName : profile.VisitorLabel ?? $"Profile {profile.Id}")</h3>
                            <p class="card-subtitle text-body-secondary mb-0">
                                @(profile.CompanyName ?? "Company unknown")
                                @if (!string.IsNullOrWhiteSpace(profile.JobTitle))
                                {
                                    <span>&middot; @profile.JobTitle</span>
                                }
                            </p>
                        </div>
                        <span class="badge bg-primary-subtle text-primary">@profile.ProfileCompleteness% detail</span>
                    </div>

                    <div class="crm-profile-field-grid">
                        <div><span>Email</span><strong>@(profile.Email ?? "Unknown")</strong></div>
                        <div><span>Phone</span><strong>@(profile.Phone ?? "Unknown")</strong></div>
                        <div><span>Location</span><strong>@(profile.Location ?? "Unknown")</strong></div>
                        <div><span>Language</span><strong>@(profile.Language ?? "Unknown")</strong></div>
                        <div><span>Customer Type</span><strong>@(profile.CustomerType ?? "Unknown")</strong></div>
                        <div><span>Lifecycle</span><strong>@(profile.LifecycleStage ?? "Unknown")</strong></div>
                        <div><span>Budget</span><strong>@(profile.BudgetRange ?? "Unknown")</strong></div>
                        <div><span>Timeline</span><strong>@(profile.Timeline ?? "Unknown")</strong></div>
                        <div><span>Decision Role</span><strong>@(profile.DecisionRole ?? "Unknown")</strong></div>
                        <div><span>Priority</span><strong>@profile.PriorityScore</strong></div>
                    </div>

                    <div class="crm-profile-section">
                        <span>Intent</span>
                        <p>@(profile.IntentSummary ?? "Unknown")</p>
                    </div>
                    <div class="crm-profile-section">
                        <span>Need Summary</span>
                        <p>@(profile.NeedSummary ?? "Unknown")</p>
                    </div>
                    <div class="crm-profile-section">
                        <span>Product Interest</span>
                        <p>@(profile.ProductInterest ?? "Unknown")</p>
                    </div>
                    <div class="crm-profile-section">
                        <span>Pain Points</span>
                        <p>@(profile.PainPoints ?? "Unknown")</p>
                    </div>
                    <div class="crm-profile-section">
                        <span>Objections</span>
                        <p>@(profile.Objections ?? "Unknown")</p>
                    </div>
                    <div class="crm-profile-section">
                        <span>Preferences</span>
                        <p>@(profile.Preferences ?? "Unknown")</p>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        @if (profile.ConversationId.HasValue)
                        {
                            <a class="btn btn-outline-primary btn-sm" asp-page="/Crm/Conversations" asp-route-conversationId="@profile.ConversationId">Open Conversation</a>
                        }
                        <span class="btn btn-light btn-sm disabled">@profile.MessageCount messages &middot; @profile.ImageMessageCount images</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
