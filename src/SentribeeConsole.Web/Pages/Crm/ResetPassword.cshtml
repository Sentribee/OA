@page "/oa/reset-password"
@model SentribeeConsole.Web.Pages.Crm.ResetPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
    ViewData["AuthBodyClass"] = "crm-login-shell";
}

<div id="login-feedback"
     class="login-toast @(string.IsNullOrEmpty(Model.AlertMessage) ? null : "is-visible")"
     role="alert"
     aria-live="assertive">
    <i class="material-symbols-rounded">info</i>
    <span>@Model.AlertMessage</span>
</div>

<section class="card login-card mw-400 w-100 p-7 p-md-8">
    <div class="d-flex align-items-center gap-3 mb-7">
        <img class="brand-logo" src="~/images/sentribee-mark.png" alt="SentriBee" width="44" height="44" />
        <div>
            <h1 class="login-brand-name fs-5 mb-0">Sentribee OA</h1>
            <div class="text-body-secondary fs-7">Staff password reset</div>
        </div>
    </div>

    @if (Model.TokenIsValid)
    {
        <h2 class="fs-6 text-body-emphasis">Set a new password</h2>
        <div class="text-body-secondary mb-5">Choose a new password for @Model.DisplayEmail.</div>

        <form method="post" class="mb-5" novalidate>
            <input asp-for="Token" type="hidden" />
            <div class="form-icon mb-3">
                <i class="material-symbols-rounded">lock</i>
                <input asp-for="NewPassword" type="password" class="form-control" placeholder="New password" autocomplete="new-password" />
            </div>
            <span asp-validation-for="NewPassword" class="text-danger fs-8 d-block mb-3"></span>
            <div class="form-icon mb-3">
                <i class="material-symbols-rounded">lock_reset</i>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" autocomplete="new-password" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger fs-8 d-block mb-4"></span>
            <button type="submit" class="btn btn-primary w-100">
                <i class="material-symbols-rounded">check</i> Reset password
            </button>
        </form>
    }
    else
    {
        <h2 class="fs-6 text-body-emphasis">Reset link unavailable</h2>
        <div class="text-body-secondary mb-5">This reset link is invalid or expired. Request a new link to continue.</div>
        <a asp-page="/Crm/ForgotPassword" class="btn btn-primary w-100">
            <i class="material-symbols-rounded">outgoing_mail</i> Request a new link
        </a>
    }

    <a asp-page="/Crm/Login" class="btn btn-outline-secondary w-100 mt-3">
        <i class="material-symbols-rounded">arrow_back</i> Back to sign in
    </a>
</section>
