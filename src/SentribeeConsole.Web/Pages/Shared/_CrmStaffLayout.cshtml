@using SentribeeConsole.Web.Pages.Crm
@{
    var staff = ViewData["CrmEmployee"] as CrmEmployeeSession;
    var activeMenu = ViewData["ActiveMenu"] as string ?? "StaffDashboard";
}
<!doctype html>
<html lang="en" data-bs-theme="light" data-theme-color="purple">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sentribee OA</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link rel="stylesheet" href="~/theme/vendor-DDXwb3B2.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="crm-shell">
    <aside class="crm-sidebar">
        <a asp-page="/Crm/StaffDashboard" class="crm-brand">
            <img src="~/images/sentribee-mark.png" alt="" />
            <span>Sentribee OA</span>
        </a>
        <div class="crm-merchant-chip">
            <div class="fw-semibold">@staff?.BusinessName</div>
            <div class="text-body-secondary fs-8">@staff?.RealName &middot; @staff?.RoleName</div>
        </div>
        <nav class="crm-nav">
            <div class="crm-nav-section">我的工作</div>
            <a asp-page="/Crm/StaffDashboard" class="@(activeMenu == "StaffDashboard" ? "active" : null)"><i class="material-symbols-rounded">dashboard</i><span>Dashboard</span></a>
            <a asp-page="/Crm/StaffAttendance" class="@(activeMenu == "StaffAttendance" ? "active" : null)"><i class="material-symbols-rounded">schedule</i><span>My Attendance</span></a>
            <a asp-page="/Crm/StaffLeave" class="@(activeMenu == "StaffLeave" ? "active" : null)"><i class="material-symbols-rounded">event_busy</i><span>My Leave</span></a>
            @if (staff?.CanApproveLeave == true)
            {
                <div class="crm-nav-section">审批</div>
                <a asp-page="/Crm/StaffApprovals" class="@(activeMenu == "StaffApprovals" ? "active" : null)"><i class="material-symbols-rounded">approval</i><span>Approvals</span></a>
            }
            <div class="crm-nav-section">账号</div>
            <a asp-page="/Crm/StaffProfile" class="@(activeMenu == "StaffProfile" ? "active" : null)"><i class="material-symbols-rounded">account_circle</i><span>My Profile</span></a>
        </nav>
        <form method="post" asp-page="/Crm/Logout" class="mt-auto">
            <button type="submit" class="btn btn-outline-secondary w-100"><i class="material-symbols-rounded">logout</i> Sign out</button>
        </form>
    </aside>
    <main class="crm-main">
        <header class="crm-header">
            <div>
                <h1>@ViewData["PageTitle"]</h1>
                <div class="text-body-secondary fs-8">@staff?.WorkEmail</div>
            </div>
        </header>
        @RenderBody()
    </main>
    <script type="module" src="~/theme/vendor-DWdXmVBv.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
